# Copy to .env (never commit it) or set these in the Windows environment.
#
# Keys set here are a fallback: the application prefers keys saved through
# Settings, which are stored in Windows Credential Manager rather than on disk.

# Speech recognition - ElevenLabs Scribe v2 Realtime
ELEVENLABS_API_KEY=

# Answer generation - OpenAI Responses API
OPENAI_API_KEY=

# Opt in to the billable live integration tests (pytest -m live)
# AZCOPILOT_LIVE_TESTS=1

# Override where settings, logs and benchmarks are written
# AZCOPILOT_DATA_DIR=C:\Users\you\AppData\Local\AzInterviewCopilot
